# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=travel_tours_db
DB_USER=root
DB_PASSWORD=your_db_password

# JWT
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# File Uploads
UPLOAD_PATH=./uploads
MAX_FILE_SIZE_MB=5
QR_MAX_FILE_SIZE_MB=2

# Frontend
FRONTEND_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Booking
SEAT_LOCK_MINUTES=10
MAX_SEATS_PER_BOOKING=6

# Demo seed admin (development only - read by `npm run db:seed`; never use in production)
SEED_ADMIN_EMAIL=admin@ganrajtraveling.demo
SEED_ADMIN_PASSWORD=change_me_for_local_demo
# Optional: lets the three named demo customers log in on the website
SEED_CUSTOMER_PASSWORD=
